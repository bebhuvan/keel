#!/bin/sh
# Keel's only step that needs the administrator password, run through pkexec
# with the prompt from /usr/share/polkit-1/actions/dev.keel.helper.policy.
# It accepts exactly this form and refuses anything else:
#
#   keel-helper battery-care on|off
set -eu
PATH=/usr/bin:/bin

usage() {
  echo "usage: keel-helper battery-care on|off" >&2
  exit 2
}

[ $# -eq 2 ] || usage
[ "$1" = battery-care ] || usage
case "$2" in on | off) ;; *) usage ;; esac

found=0
rule=/etc/udev/rules.d/99-battery-charge-threshold.rules
tmp="$rule.tmp.$$"

if [ "$2" = on ]; then
  : >"$tmp"
  for dir in /sys/class/power_supply/BAT*; do
    [ -e "$dir/charge_control_end_threshold" ] || continue
    name=$(basename "$dir")
    case "$name" in BAT[0-9] | BAT[0-9][0-9]) ;; *) continue ;; esac
    found=1
    if [ -e "$dir/charge_control_start_threshold" ]; then
      printf 'SUBSYSTEM=="power_supply", KERNEL=="%s", ATTR{charge_control_end_threshold}="80", ATTR{charge_control_start_threshold}="75"\n' "$name" >>"$tmp"
      # Raise end first in case a lower limit (<= 75) is currently active,
      # then set start below end, then lower end to 80.
      echo 100 >"$dir/charge_control_end_threshold"
      echo 75 >"$dir/charge_control_start_threshold"
    else
      printf 'SUBSYSTEM=="power_supply", KERNEL=="%s", ATTR{charge_control_end_threshold}="80"\n' "$name" >>"$tmp"
    fi
    echo 80 >"$dir/charge_control_end_threshold"
  done
  if [ "$found" -eq 0 ]; then
    rm -f "$tmp"
    echo "keel-helper: no battery with a charge limit" >&2
    exit 1
  fi
  mv -f "$tmp" "$rule"
  rm -f "$rule.disabled"
else
  for dir in /sys/class/power_supply/BAT*; do
    [ -e "$dir/charge_control_end_threshold" ] || continue
    name=$(basename "$dir")
    case "$name" in BAT[0-9] | BAT[0-9][0-9]) ;; *) continue ;; esac
    found=1
    echo 100 >"$dir/charge_control_end_threshold"
    if [ -e "$dir/charge_control_start_threshold" ]; then
      echo 0 >"$dir/charge_control_start_threshold"
    fi
  done
  if [ "$found" -eq 0 ]; then
    echo "keel-helper: no battery with a charge limit" >&2
    exit 1
  fi
  if [ -e "$rule" ]; then
    mv -f "$rule" "$rule.disabled"
  fi
fi
