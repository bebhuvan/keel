pkgname=keel
pkgver=0.1.0
pkgrel=1
pkgdesc='A calm command center for an Omarchy laptop: stats in plain words, switches, apps and disk space'
url='https://github.com/bebhuvan/keel'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'networkmanager' 'wireplumber' 'brightnessctl' 'power-profiles-daemon' 'polkit' 'inter-font')
optdepends=('ddcutil: external monitor brightness control')
makedepends=('gcc' 'make')
# No separate keel-debug package of debugging symbols; nobody here needs it.
options=('!debug')
source=()
sha256sums=()

# The package is compiled in its own fresh folder, not the developer's
# build/, so every object is built with makepkg's hardening flags.
build() {
  mkdir -p "$srcdir/release"
  cd "$srcdir/release"
  qmake6 "$startdir/../keel.pro"
  make -j"$(nproc)"
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/release/keel" "$pkgdir/usr/bin/keel"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/keel.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/keel.svg"
  install -Dm644 "$startdir/keel.desktop" "$pkgdir/usr/share/applications/keel.desktop"
  install -Dm755 "$startdir/keel-helper" "$pkgdir/usr/lib/keel/keel-helper"
  install -Dm644 "$startdir/dev.keel.helper.policy" "$pkgdir/usr/share/polkit-1/actions/dev.keel.helper.policy"
}
